            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Mass",
            "type": "number",
            "uniqueItems": false,
            "writeOnly": false
          },
          "routeLength": {
            "default": "The length of the traveling route in meter.",
            "example": 752,
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Route Length",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          },
          "routeMainModalChoice": {
            "default": "The main modality of the traveling route.",
            "example": "walking",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Route Main Modality",
            "type": "string",
            "uniqueItems": false,
            "writeOnly": false
