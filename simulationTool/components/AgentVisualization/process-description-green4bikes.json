            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Modality Count",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          },
          "startX": {
            "default": "The longitude position of the start position.",
            "example": 9.9871464,
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Start Longitude/X",
            "type": "number",
            "uniqueItems": false,
            "writeOnly": false
          },
          "startY": {
            "default": "The latitude position of the start position.",
            "example": 53.4563488,
            "minLength": 0,
