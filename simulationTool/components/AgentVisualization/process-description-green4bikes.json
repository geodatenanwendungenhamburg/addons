{
  "description": "Travelling model to simulate the mobility behavior of people walking and cycling from selected starts and stops in the area of Hamburg Harburg.",
  "id": "mars:sim-green4Bikes-default",
  "inputs": {
    "config": {
      "additionalParameters": {
        "href": "https://www.mars-group.org/docs/category/configuration",
        "title": "Simulation config documentation"
      },
      "description": "The global configuration used to parameterize all settings of the scenarios, allowing to override each configuration and used resource.",
      "minOccurs": 1,
      "schema": {
        "contentMediaType": "application/json",
        "minLength": 0,
        "nullable": true,
        "readOnly": false,
        "uniqueItems": false,
        "writeOnly": false
      },
      "title": "An optional scenario configuration to override each setting."
    },
    "cycleTravelerLayer": {
      "description": "Cycle traveler event layer, spawning new agents with source and target",
      "minOccurs": 1,
      "schema": {
        "contentSchema": "application/geo+json",
        "format": "geojson-feature-collection",
        "minLength": 0,
        "nullable": false,
        "properties": {
          "endTime": {
            "description": "The end time in ISO 8601 when this spawning events ends. When not defined the end of the simulation is used.",
            "example": "01.01.0001T14:00",
            "format": "dateTime",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Event End Time",
            "type": "string",
            "uniqueItems": false,
            "writeOnly": false
          },
          "gender": {
            "default": "male",
            "description": "The biological gender with impact on the walking speed",
            "enum": [
              "female",
              "male"
            ],
            "example": "female",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Gender",
            "type": "string",
            "uniqueItems": false,
            "writeOnly": false
          },
          "gradient": {
            "description": "The speed gradient to determine the speed change",
            "minLength": 0,
            "nullable": true,
            "readOnly": false,
            "title": "Gradient",
            "type": "number",
            "uniqueItems": false,
            "writeOnly": false
          },
          "hasOwnBikeProbability": {
            "default": 0,
            "description": "The probability of the spawned agent to owning a personal bike instead of using a rental one.",
            "example": 10,
            "maximum": 100,
            "minLength": 0,
            "minimum": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Bike Owner Probability",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          },
          "mass": {
            "default": 80,
            "description": "The mass of the traveler with impact on the walking speed",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Mass",
            "type": "number",
            "uniqueItems": false,
            "writeOnly": false
          },
          "spawningAmount": {
            "default": 0,
            "description": "The amount of agents to spawn for each occured event.",
            "example": 50,
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Spawning Amount",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          },
          "spawningIntervalInMinutes": {
            "description": "The interval in minutes how often this events occur between the start and end.",
            "example": 20,
            "minLength": 0,
            "nullable": true,
            "readOnly": false,
            "title": "Spawning Interval",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          },
          "startTime": {
            "description": "The start time in ISO 8601 when this spawning events start. When not defined the end of the simulation is used.",
            "example": "01.01.0001T07:00",
            "format": "dateTime",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Event Start Time",
            "type": "string",
            "uniqueItems": false,
            "writeOnly": false
          }
        },
        "readOnly": false,
        "type": "string",
        "uniqueItems": false,
        "writeOnly": false
      },
      "title": "Cycle Traveler Agent Layer"
    },
    "cycleTravelerSource": {
      "description": "The source area and input configuration of cycle traveler where they shall be spawend",
      "minOccurs": 1,
      "schema": {
        "contentSchema": "application/geo+json",
        "format": "geojson-feature",
        "minLength": 0,
        "nullable": false,
        "properties": {
          "endTime": {
            "description": "The end time in ISO 8601 when this spawning events ends. When not defined the end of the simulation is used.",
            "example": "01.01.0001T14:00",
            "format": "dateTime",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Event End Time",
            "type": "string",
            "uniqueItems": false,
            "writeOnly": false
          },
          "gender": {
            "default": "male",
            "description": "The biological gender with impact on the walking speed",
            "enum": [
              "female",
              "male"
            ],
            "example": "female",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Gender",
            "type": "string",
            "uniqueItems": false,
            "writeOnly": false
          },
          "gradient": {
            "description": "The speed gradient to determine the speed change",
            "minLength": 0,
            "nullable": true,
            "readOnly": false,
            "title": "Gradient",
            "type": "number",
            "uniqueItems": false,
            "writeOnly": false
          },
          "hasOwnBikeProbability": {
            "default": 0,
            "description": "The probability of the spawned agent to owning a personal bike instead of using a rental one.",
            "example": 10,
            "maximum": 100,
            "minLength": 0,
            "minimum": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Bike Owner Probability",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          },
          "mass": {
            "default": 80,
            "description": "The mass of the traveler with impact on the walking speed",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Mass",
            "type": "number",
            "uniqueItems": false,
            "writeOnly": false
          },
          "spawningAmount": {
            "default": 0,
            "description": "The amount of agents to spawn for each occured event.",
            "example": 50,
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Spawning Amount",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          },
          "spawningIntervalInMinutes": {
            "description": "The interval in minutes how often this events occur between the start and end.",
            "example": 20,
            "minLength": 0,
            "nullable": true,
            "readOnly": false,
            "title": "Spawning Interval",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          },
          "startTime": {
            "description": "The start time in ISO 8601 when this spawning events start. When not defined the end of the simulation is used.",
            "example": "01.01.0001T07:00",
            "format": "dateTime",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Event Start Time",
            "type": "string",
            "uniqueItems": false,
            "writeOnly": false
          }
        },
        "readOnly": false,
        "type": "string",
        "uniqueItems": false,
        "writeOnly": false
      },
      "title": "Cycle Traveler Source"
    },
    "cycleTravelerTarget": {
      "description": "The target area where the traveler shall move to",
      "minOccurs": 1,
      "schema": {
        "contentSchema": "application/geo+json",
        "format": "geojson-geometry",
        "minLength": 0,
        "nullable": false,
        "readOnly": false,
        "type": "string",
        "uniqueItems": false,
        "writeOnly": false
      },
      "title": "Cycle Traveler Target"
    },
    "endPoint": {
      "description": "The time point when the simulation end internally. Specified as ISO 8601 format",
      "minOccurs": 1,
      "schema": {
        "format": "dateTime",
        "minLength": 0,
        "nullable": true,
        "readOnly": false,
        "type": "string",
        "uniqueItems": false,
        "writeOnly": false
      },
      "title": "The concrete end datetime of the simulation time to calculate"
    },
    "rentalBicycle": {
      "description": "The bicycle type to use for the rental stations",
      "maxOccurs": 1,
      "minOccurs": 0,
      "schema": {
        "allOf": [
          {
            "minLength": 0,
            "nullable": false,
            "properties": {
              "height": {
                "default": 0,
                "description": "The height of this bike in meter.",
                "minLength": 0,
                "nullable": false,
                "readOnly": false,
                "title": "Height",
                "type": "number",
                "uniqueItems": false,
                "writeOnly": false
              },
              "length": {
                "default": 2,
                "description": "The length of this bike in meter.",
                "minLength": 0,
                "nullable": false,
                "readOnly": false,
                "title": "Length",
                "type": "number",
                "uniqueItems": false,
                "writeOnly": false
              },
              "maxAcceleration": {
                "default": 3,
                "description": "The maximum acceleration of this bike in meter per squared second.",
                "minLength": 0,
                "nullable": false,
                "readOnly": false,
                "title": "Max Acceleration",
                "type": "number",
                "uniqueItems": false,
                "writeOnly": false
              },
              "maxDeceleration": {
                "default": 0,
                "description": "The maximum deceleration of this bike.",
                "minLength": 0,
                "nullable": false,
                "readOnly": false,
                "title": "Max Deceleration",
                "type": "number",
                "uniqueItems": false,
                "writeOnly": false
              },
              "maxSpeed": {
                "default": 13.89,
                "description": "The maximum speed of this bike in meter per seconds.",
                "minLength": 0,
                "nullable": false,
                "readOnly": false,
                "title": "Max Speed",
                "type": "number",
                "uniqueItems": false,
                "writeOnly": false
              },
              "type": {
                "default": "city",
                "description": "The bike type name e.g., electric bike or pedelec",
                "minLength": 0,
                "nullable": false,
                "readOnly": false,
                "title": "Bike Type",
                "type": "string",
                "uniqueItems": false,
                "writeOnly": false
              },
              "width": {
                "default": 1,
                "description": "The width of this bike in meter.",
                "minLength": 0,
                "nullable": false,
                "readOnly": false,
                "title": "Width",
                "type": "number",
                "uniqueItems": false,
                "writeOnly": false
              }
            },
            "readOnly": false,
            "type": "object",
            "uniqueItems": false,
            "writeOnly": false
          }
        ],
        "minItems": 0,
        "minLength": 0,
        "nullable": false,
        "readOnly": false,
        "type": "array",
        "uniqueItems": false,
        "writeOnly": false
      },
      "title": "Rental Bike Types"
    },
    "rentalStations": {
      "description": "Different stations within the simulation, used rental bicycles for movement",
      "minOccurs": 0,
      "schema": {
        "allOf": [
          {
            "format": "geojson-geometry",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "uniqueItems": false,
            "writeOnly": false
          }
        ],
        "contentSchema": "application/geo+json",
        "format": "geojson-feature-collection",
        "minLength": 0,
        "nullable": false,
        "properties": {
          "amount_bicycles": {
            "default": 10,
            "description": "The amount of rentable bicycles",
            "example": 15,
            "minLength": 0,
            "minimum": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Bicycle Amount",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          },
          "anzahl_raeder": {
            "default": 10,
            "description": "The amount of rentable bicycles",
            "example": 15,
            "minLength": 0,
            "minimum": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Bicycle Amount (Alternative to amount_bicycles)",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          }
        },
        "readOnly": false,
        "type": "string",
        "uniqueItems": false,
        "writeOnly": false
      },
      "title": "Rental Bicycle Stations"
    },
    "roadNetwork": {
      "description": "The input network used to represent the environment where the agents can move on",
      "minOccurs": 0,
      "schema": {
        "allOf": [
          {
            "format": "geojson-geometry",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "uniqueItems": false,
            "writeOnly": false
          }
        ],
        "contentSchema": "application/geo+json",
        "format": "geojson-feature-collection",
        "minLength": 0,
        "nullable": false,
        "properties": {
          "lanes": {
            "description": "The count of lanes of this road segment",
            "example": "2",
            "minLength": 0,
            "minimum": 1,
            "nullable": true,
            "readOnly": false,
            "title": "Lanes",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          }
        },
        "readOnly": false,
        "type": "string",
        "uniqueItems": false,
        "writeOnly": false
      },
      "title": "Moving Network Environment"
    },
    "startPoint": {
      "description": "The time point when the simulation starts internally. Specified as ISO 8601 format",
      "minOccurs": 1,
      "schema": {
        "format": "dateTime",
        "minLength": 0,
        "nullable": true,
        "readOnly": false,
        "type": "string",
        "uniqueItems": false,
        "writeOnly": false
      },
      "title": "The concrete start datetime of the simulation time to calculate"
    },
    "steps": {
      "description": "The amount of steps in seconds to simulate used instead of end time point, starting from start time point",
      "minOccurs": 1,
      "schema": {
        "maximum": 1000,
        "minLength": 0,
        "minimum": 0,
        "nullable": false,
        "readOnly": false,
        "type": "number",
        "uniqueItems": false,
        "writeOnly": false
      },
      "title": "The amount of steps in seconds to simulate."
    }
  },
  "jobControlOptions": [
    "sync-execute",
    "async-execute"
  ],
  "keywords": [
    "cycling",
    "travelling",
    "simulation"
  ],
  "outputTransmission": [
    "value"
  ],
  "outputs": {
    "agents": {
      "format": {
        "mediaType": "application/geo+json"
      },
      "schema": {
        "contentMediaType": "application/geo+json",
        "default": {
          "features": [],
          "type": "FeatureCollection"
        },
        "example": {
          "features": [
            {
              "geometry": {
                "coordinates": [
                  9.978667786160287,
                  53.54407542750305
                ],
                "type": "Point"
              },
              "properties": {
                "activeCapability": "Walking",
                "distanceStartGoal": 6281.220268477454,
                "routeLength": 8838,
                "step": 12,
                "time": "2024-12-01 07:20:01"
              },
              "type": "Feature"
            }
          ],
          "type": "FeatureCollection"
        },
        "format": "geojson-feature-collection",
        "minLength": 0,
        "nullable": false,
        "properties": {
          "activeCapability": {
            "default": "The currently active used modality to move.",
            "example": "walking",
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Active Capability",
            "type": "string",
            "uniqueItems": false,
            "writeOnly": false
