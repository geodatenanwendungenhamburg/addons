            "readOnly": false,
            "title": "Start Latitude/Y",
            "type": "number",
            "uniqueItems": false,
            "writeOnly": false
          },
          "step": {
            "default": "The simulation step where this data point valid",
            "example": 12,
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Simulation Step",
            "type": "integer",
            "uniqueItems": false,
            "writeOnly": false
          },
          "time": {
            "default": "The local simulation time in ISO 8601 where this data point valid.",
            "example": 12,
            "minLength": 0,
            "nullable": false,
            "readOnly": false,
            "title": "Simulation Step",
